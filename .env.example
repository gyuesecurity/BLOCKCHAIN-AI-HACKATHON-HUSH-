# Local demo administration only. Use a long random value outside local development.
HUSH_DEMO_ADMIN_KEY=replace-with-a-random-secret

# 방 상태 영구 저장. 미설정 시 repo 루트 hush-demo.db (SQLite, 인프라 0).
#   Railway/Postgres: 플랫폼이 주입하는 DATABASE_URL 을 그대로 두면 자동 인식된다
#   (postgres:// 스킴은 psycopg 드라이버로 자동 변환). pip install -e '.[postgres]'
# HUSH_DATABASE_URL=sqlite:///./hush-demo.db
#
# 저장된 방 상태(대부분 참가자 private 데이터: salt·원값·세션 토큰·원문)의
# at-rest 암호화 키. 미설정 시 평문 JSON 저장 + 경고 로그. 재시작 후에도 복호화
# 하려면 같은 키를 유지해야 한다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HUSH_STATE_KEY=

# 실제 LLM(Google Gemini) 자연어 구조화. 키가 있으면 자동 사용, 없으면 규칙 파서 fallback.
#   pip install -e '.[llm]'  후 아래 키를 설정한다. (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# HUSH_LLM_ENABLED=true             # 키가 있어도 강제로 끄려면 false
# HUSH_LLM_MODEL=gemini-3.5-flash-lite   # 기본값

# 최종 결정 커밋을 EVM testnet(기본 Ethereum Sepolia)에 기록. 키+주소가 모두 있으면
# 자동 사용, 아니면 local verification fallback (fake tx/explorer는 만들지 않음).
#   pip install -e '.[chain]'
#   python scripts/new_wallet.py      # testnet 전용 relayer 지갑 생성 → faucet 충전
#     Sepolia faucet (로그인 불필요): https://sepolia-faucet.pk910.de
#   python scripts/deploy_contract.py # 레지스트리 배포 → 아래 주소 출력
# HUSH_CHAIN_PRIVATE_KEY=0x...            # testnet 전용. 커밋 금지, mainnet 자금 금지
# HUSH_CHAIN_CONTRACT_ADDRESS=0x946ff260a3F67A37c6D0B60bD2E5db905b499cf8  # 이미 배포됨 (재사용 가능)
# HUSH_CHAIN_ENABLED=true                 # 강제 on/off
# HUSH_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# HUSH_CHAIN_ID=11155111                  # 기본값 (Ethereum Sepolia)
# HUSH_CHAIN_NETWORK_NAME=Ethereum Sepolia
# HUSH_CHAIN_EXPLORER=https://sepolia.etherscan.io
# HUSH_CHAIN_TX_TIMEOUT=150               # 트랜잭션 확정 대기 초

