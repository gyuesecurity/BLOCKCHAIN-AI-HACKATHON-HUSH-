# Local demo administration only. Use a long random value outside local development.
HUSH_DEMO_ADMIN_KEY=replace-with-a-random-secret

# 실제 LLM(Google Gemini) 자연어 구조화. 키가 있으면 자동 사용, 없으면 규칙 파서 fallback.
#   pip install -e '.[llm]'  후 아래 키를 설정한다. (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# HUSH_LLM_ENABLED=true             # 키가 있어도 강제로 끄려면 false
# HUSH_LLM_MODEL=gemini-3.5-flash-lite   # 기본값

# 최종 결정 커밋을 EVM testnet(기본 Base Sepolia)에 기록. 키+주소가 모두 있으면
# 자동 사용, 아니면 local verification fallback (fake tx/explorer는 만들지 않음).
#   pip install -e '.[chain]'
#   python scripts/new_wallet.py      # testnet 전용 relayer 지갑 생성 → faucet 충전
#   python scripts/deploy_contract.py # 레지스트리 배포 → 아래 주소 출력
# HUSH_CHAIN_RPC_URL=https://sepolia.base.org
# HUSH_CHAIN_PRIVATE_KEY=0x...            # testnet 전용. 커밋 금지, mainnet 자금 금지
# HUSH_CHAIN_CONTRACT_ADDRESS=0x...       # deploy_contract.py 결과
# HUSH_CHAIN_ENABLED=true                 # 강제 on/off
# HUSH_CHAIN_ID=84532                     # 기본값 (Base Sepolia)
# HUSH_CHAIN_NETWORK_NAME=Base Sepolia
# HUSH_CHAIN_EXPLORER=https://sepolia.basescan.org
# HUSH_CHAIN_TX_TIMEOUT=150               # 트랜잭션 확정 대기 초

